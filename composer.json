{
    "name": "app/akeneo-token-app",
    "description": "Minimal app to retrieve Akeneo PIM access tokens via OAuth",
    "type": "project",
    "require": {
        "php": ">=8.2",
        "symfony/console": "7.2.*",
        "symfony/framework-bundle": "7.2.*",
        "symfony/twig-bundle": "7.2.*",
        "symfony/http-client": "7.2.*",
        "symfony/yaml": "7.2.*",
        "symfony/dotenv": "7.2.*",
        "symfony/runtime": "7.2.*",
        "symfony/orm-pack": "^2.4",
        "symfony/form": "7.2.*",
        "symfony/validator": "7.2.*",
        "symfony/security-bundle": "7.2.*",
        "symfony/mime": "7.2.*"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "config": {
        "allow-plugins": {
            "symfony/runtime": true
        }
    },
    "extra": {
        "symfony": {
            "allow-contrib": false
        }
    }
}
